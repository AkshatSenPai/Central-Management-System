generator client {
  provider = "prisma-client-js"

  /// For AttendanceSession's partial unique index — "at most one OPEN session
  /// per member", which is the only thing standing between a double-tapped
  /// punch button and two concurrent open sessions. Verified on prisma 7.9.1:
  /// without this flag `@@unique([...], where: {...})` is a validation error;
  /// with it, `migrate diff` emits
  ///   CREATE UNIQUE INDEX ... ON "AttendanceSession"("memberId")
  ///     WHERE ("resolution" IS NULL);
  /// The alternative was hand-writing that line into migration.sql, which is
  /// drift the datamodel cannot see and the next `migrate dev` writes a DROP
  /// for. A preview flag is the cheaper of the two risks.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  name              String
  passwordHash      String?
  role              Role                    @default(MEMBER)
  active            Boolean                 @default(true)
  title             String?
  phone             String?
  avatarUrl         String?
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  invitesCreated    Invite[]                @relation("InviteCreator")
  activity          ActivityLog[]           @relation("ActivityActor")
  clientsLed        Client[]                @relation("ClientAccountLead")
  tasksCreated      Task[]                  @relation("TaskCreator")
  taskAssignments   TaskAssignee[]
  eventsCreated     CalendarEvent[]         @relation("CalendarEventCreator")
  eventAttendance   CalendarEventAttendee[]
  comments          Comment[]               @relation("CommentAuthor")
  attachments       Attachment[]            @relation("AttachmentUploader")
  announcements     Announcement[]          @relation("AnnouncementAuthor")
  notifications     Notification[]          @relation("NotificationRecipient")
  notified          Notification[]          @relation("NotificationActor")
  feedback          Feedback[]              @relation("FeedbackAuthor")
  feedbackHandled   Feedback[]              @relation("FeedbackResolver")
  attendance        AttendanceSession[]     @relation("AttendanceMember")
  attendanceFixed   AttendanceSession[]     @relation("AttendanceResolver")
  pushSubscriptions PushSubscription[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  FORMER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  /// Shipped, and the studio is still supporting it — the client's funnel,
  /// CRM or marketing kept running after delivery. Counts as active work:
  /// `isProjectActive` is `status !== "DONE"`, so a maintained project stays
  /// in its client's active total and in the task form's project picker.
  MAINTENANCE
  DONE
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  BLOCKED
}

enum ProgressMode {
  AUTO
  MANUAL
}

model Client {
  id             String          @id @default(cuid())
  name           String          @unique
  status         ClientStatus    @default(ACTIVE)
  sector         String?
  website        String?
  engagementType String?
  clientSince    DateTime?
  notes          String?
  accountLead    User?           @relation("ClientAccountLead", fields: [accountLeadId], references: [id])
  accountLeadId  String?
  contacts       ClientContact[]
  projects       Project[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([accountLeadId])
}

model ClientContact {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Project {
  id             String          @id @default(cuid())
  client         Client          @relation(fields: [clientId], references: [id])
  clientId       String
  name           String
  description    String?
  status         ProjectStatus   @default(PLANNING)
  health         ProjectHealth   @default(ON_TRACK)
  progressMode   ProgressMode    @default(AUTO)
  manualProgress Int?
  startDate      DateTime?
  dueDate        DateTime?
  milestones     Milestone[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
}

model Milestone {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  order       Int
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

/// Generic audit trail (spec §7). `entityType` and `action` are plain String
/// columns typed as TypeScript unions so later phases add verbs without a
/// migration. `clientId` is a denormalised scope key with deliberately NO
/// relation and no onDelete — the audit trail must survive a client
/// hard-delete. Do not "fix" it by adding a relation.
model ActivityLog {
  id         String   @id @default(cuid())
  actor      User     @relation("ActivityActor", fields: [actorId], references: [id])
  actorId    String
  entityType String
  entityId   String
  action     String
  meta       Json?
  clientId   String?
  at         DateTime @default(now())

  @@index([clientId, at])
  @@index([entityType, entityId, at])
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id String @id @default(cuid())

  /// The human-facing handle — rendered as MER-024. A cuid is unspeakable;
  /// this is the thing someone says out loud on a call. Postgres owns the
  /// sequence, so two simultaneous creates cannot collide, which a
  /// max()+1 read in the service could not promise.
  ///
  /// Never reused. Deleting MER-024 does not free the number, and it should
  /// not: a reference in someone's notes must not later point at a different
  /// task.
  reference Int @unique @default(autoincrement())

  title       String
  description String?
  project     Project?        @relation(fields: [projectId], references: [id])
  projectId   String?
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id])
  milestoneId String?
  creator     User            @relation("TaskCreator", fields: [creatorId], references: [id])
  creatorId   String
  status      TaskStatus      @default(TO_DO)
  priority    TaskPriority    @default(MEDIUM)
  dueDate     DateTime?
  order       Int
  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  comments    Comment[]

  /// Sequencing, both directions. `blockedBy` is what this task waits on;
  /// `blocking` is what waits on it. There is deliberately no `blocked`
  /// column beside them — see TaskDependency.
  blockedBy TaskDependency[] @relation("BlockedTask")
  blocking  TaskDependency[] @relation("BlockerTask")

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
}

model TaskAssignee {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@id([taskId, userId])
  @@index([userId])
}

/// "A is blocked by B" — B must reach DONE before A may leave TO_DO.
///
/// The edge direction is worth reading twice, because both columns are Tasks
/// and a reversed pair is a silent logic inversion no type can catch:
/// `blockedTaskId` is the task that must WAIT, `blockerTaskId` is the task
/// being waited ON.
///
/// Both sides Cascade. A deleted task cannot block anything and cannot be
/// blocked by anything, so the row is meaningless the moment either end goes
/// — unlike ActivityLog, which is history and must outlive its subject. The
/// same reasoning PushSubscription records: this is a live constraint, not a
/// fact about the past.
///
/// **There is deliberately no `blocked` column on Task, and there must never
/// be one.** Blockedness is derived from these rows' statuses at read time
/// (`isTaskBlocked`), which is what makes reopening a blocker re-block its
/// dependents with zero writes and nothing to backfill. A stored flag would
/// need updating on every status change of every blocker, would drift the
/// first time one of those writes was missed, and would need a migration to
/// repair.
model TaskDependency {
  blockedTask   Task   @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockedTaskId String
  blocker       Task   @relation("BlockerTask", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  blockerTaskId String

  /// The pair is the identity, so the same blocker cannot be added twice and
  /// a double-submitted form is a P2002 rather than a duplicate row. Matches
  /// TaskAssignee's @@id([taskId, userId]).
  @@id([blockedTaskId, blockerTaskId])

  /// "What does this task block?" — the reverse read that task detail's
  /// Blocking list needs, and which the primary key's leading column cannot
  /// serve. Same rule as TaskAssignee's @@index([userId]).
  @@index([blockerTaskId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

/// Plain text, never markdown or HTML (spec 3c D1). The renderer emits React
/// elements, so React's escaping is the whole XSS story and there is nothing
/// to sanitise on the way in or out.
model Comment {
  id       String @id @default(cuid())
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  authorId String
  body     String

  /// Denormalised at write time, per the master spec's sketch. This is NOT
  /// what draws the mention links — the renderer re-derives those from the
  /// body against the live member list, so a renamed member's old mentions
  /// still resolve. This array is what Phase 4 will notify from, and what
  /// makes "where was I mentioned" answerable without scanning every body.
  mentionedUserIds String[]

  /// Null until the first edit; its presence renders the "edited" marker.
  /// updatedAt cannot do that job because Prisma touches it on every write.
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

/// Company-wide post (spec 6.3). Any member may post; pinning is what puts it
/// on the dashboard, and it expires on its own so nobody has to remember to
/// unpin — a board of permanently pinned notices is a board nobody reads.
model Announcement {
  id       String @id @default(cuid())
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  authorId String
  title    String
  body     String

  /// Null means never pinned. A date in the past means it was pinned and has
  /// lapsed — the row keeps the history rather than nulling it, so "this was
  /// pinned until Friday" stays answerable.
  pinnedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([pinnedUntil])
}

/// One browser's push subscription. A row here is a **delivery route to a
/// device**, not a record that anything happened — which settles most of the
/// questions this model raises: routes may be deleted freely, and a stale one
/// is a bug rather than history. Contrast AttendanceSession, which keeps its
/// rows precisely because they *are* history.
///
/// Push adds reach outside the tab; it is not a new NotificationType. `notify()`
/// still writes the bell rows inside the caller's transaction — that is what
/// stops a rolled-back comment telling somebody they were mentioned — and the
/// Server Action hands the fan-out over these rows to `after()` once the write
/// is durable, exactly as invites hand email to `sendEmail`. Nothing may push
/// from inside a transaction, for the reasons written atop `email-sender.ts`.
model PushSubscription {
  id String @id @default(cuid())

  /// Cascades, like Session and Notification, and unlike Task.creator or
  /// AttendanceSession.member. Those RESTRICT because they are history and
  /// history keeps its people; this is a live route to a browser, and a route
  /// belonging to a deleted user is one nobody may ever send to again.
  ///
  /// **Deactivation is not deletion, and the database cannot see it.** Members
  /// are deactivated rather than deleted here, so nothing above fires when
  /// somebody leaves — and their task assignments survive, so a fan-out would
  /// keep buzzing an ex-colleague's phone long after they were signed out.
  /// `setMemberActive` therefore deletes that member's rows itself, on both of
  /// its branches. That is a security rule, not hygiene.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// The push service's URL for this device — the only thing that identifies a
  /// device. `p256dh`/`auth` are subordinate key material; `id` is ours, not
  /// the browser's. Deliberately unindexed: lookups go through `endpointHash`,
  /// and the 404/410 delete happens by id on a row already in hand.
  endpoint String

  /// `sha256(endpoint)` as hex, written by the service. The real unique key.
  ///
  /// Uniqueness is **global, not per user**, and that is load-bearing. One
  /// browser profile has one subscription, so when a second person signs in on
  /// a shared machine their subscribe returns the endpoint the first person is
  /// already stored under. `@@unique([userId, endpointHash])` would keep both
  /// rows and quietly deliver the new person's mentions to the old one's
  /// device. Upsert on this column and let `userId` move: the device belongs to
  /// whoever subscribed last.
  ///
  /// A hash rather than `@unique` on `endpoint` itself because a unique index
  /// is a btree, a btree entry much over 2704 bytes is refused at INSERT, and
  /// the Push API sets no maximum endpoint length. Today's endpoints are
  /// nowhere near that, which is exactly the danger: it would work for years
  /// and then fail permanently for one person, reading as "push is broken on
  /// my machine".
  endpointHash String @unique

  /// The subscription's key material, base64url, exactly as the browser handed
  /// it over. Both required: a row missing either can never encrypt a payload,
  /// so the action refuses such a subscription rather than storing a route
  /// that cannot deliver.
  ///
  /// `auth` is a shared secret and both are per-device identifiers, so they are
  /// **never logged and never sent to the client** — the devices list selects
  /// id, userAgent and updatedAt, nothing else. Stored plaintext on purpose:
  /// the sender needs them to encrypt, so encrypting them here would be
  /// decryptable by this app's own code and buys nothing a database compromise
  /// would not already have.
  p256dh String
  auth   String

  /// The raw user-agent at subscribe time, clamped by the action. Nullable
  /// because the header can be absent, and a route that works beats a label
  /// that is missing. Stored raw with "Chrome on Android" derived at render.
  /// It earns a column because revoking is otherwise unaimable: three rows for
  /// one person are three opaque URLs, and somebody revoking the phone they
  /// lost cannot be asked to tell them apart.
  userAgent String?

  createdAt DateTime @default(now())

  /// Doubles as "last confirmed by the browser", which is why there is no
  /// `lastUsedAt` and no `failureCount`. The client re-upserts whenever it
  /// loads with a live subscription, so this moves for every device that still
  /// exists.
  ///
  /// Dead rows need no counter: a push service answers 404/410/403 for a
  /// subscription that is gone, and that is definitive on the FIRST failure —
  /// the sender deletes the row there, inside the same `after()` that tried to
  /// send. Every other status (429, 5xx, timeout) is transient and must never
  /// accumulate toward a deletion. This matters more than it looks: there is no
  /// cron in this app, so any expiry scheme needing a sweeper is one that would
  /// never run.
  updatedAt DateTime @updatedAt

  /// The only query there is: every subscription belonging to the recipients of
  /// one fan-out. Nothing sorts, filters or pages it.
  @@index([userId])
}

/// How an open attendance session stopped being open. NULL is the whole "is
/// this person at work right now" question — see the partial unique index on
/// AttendanceSession, which is the only thing that both enforces and answers
/// it.
enum AttendanceResolution {
  /// Punched out deliberately. `endedAt` is the instant they did it.
  PUNCH_OUT

  /// Left open and closed for them — they forgot to punch out and the next
  /// punch-in tidied it up, or an admin deactivated them mid-session.
  /// `endedAt` stays NULL forever, because nobody knows when they actually
  /// left and the app does not guess. The row is kept rather than deleted:
  /// "Priya was here at 09:04" is true and worth keeping.
  ///
  /// A third value, CORRECTED, existed for about half an hour on 2026-08-07,
  /// when a forgotten punch-out prompted for its real end time. The owner then
  /// ruled that attendance is presence and not hours, which made that question
  /// pointless — nothing consumes the answer — so the prompt and the value
  /// both went. No row ever held it.
  DISCARDED
}

/// One punch-in and its punch-out. Many rows per person per day, because
/// lunch splits the day and that is normal.
///
/// **This records presence, not hours** (owner ruling, 2026-08-07). Nothing in
/// the app sums these timestamps, displays a duration, or asks anyone to
/// supply one — a member is simply Active while a session is open and Offline
/// otherwise. The columns are kept because a session cannot exist without
/// knowing when it began, and because they cost nothing: if hours are ever
/// wanted the history will already be here. Do not add a totals view without
/// checking that ruling still stands.
///
/// Deliberately NO reference to Task, and there will not be one (same ruling).
/// A per-task timer measures only work that happens to have a task row, and
/// the studio does work that does not — so this model answers "was this person
/// working", never "on what".
///
/// A session belongs to the app day of its `startedAt` and is never split at
/// midnight, so a 22:00 start belongs to that day whatever time it ends. There
/// is deliberately no `day` column — a second definition of "day" written in
/// SQL is one that can disagree with `startOfAppDay`.
model AttendanceSession {
  id String @id @default(cuid())

  /// Never cascades, the same rule as Task.creator and CalendarEvent.creator:
  /// members are deactivated rather than deleted precisely so history keeps
  /// its people. Prisma's default for a required relation is RESTRICT, which
  /// is what this wants — do not "tidy" it into Cascade.
  member   User   @relation("AttendanceMember", fields: [memberId], references: [id])
  memberId String

  /// No @default(now()): the service owns this instant, because it is the same
  /// one it validates against and writes to its ActivityLog row inside a
  /// transaction, and a database-side default is invisible to that code.
  /// Matches CalendarEvent.startsAt. The client never supplies it.
  startedAt DateTime

  /// NULL means one of two very different things, and `resolution` is what
  /// tells them apart: still working, or written off unfinished. Nothing may
  /// infer an end from a shift length, a day boundary, or the next punch-in.
  endedAt DateTime?

  /// NULL exactly while the session is open. This — **not** `endedAt IS NULL` —
  /// is the openness test, and the distinction is load-bearing: a DISCARDED
  /// session keeps `endedAt` null forever, so keying openness off `endedAt`
  /// would leave it occupying the one open slot the index below permits and
  /// lock that person out of punching in ever again.
  resolution AttendanceResolution?

  /// When the resolution was made, which is not `endedAt`. A punch-out has the
  /// two equal; a Friday correction for Thursday evening has them a day apart,
  /// and "when was this claim made" is the audit question.
  resolvedAt DateTime?

  /// Normally the member themselves. Optional relation so it nulls rather than
  /// blocks, the same trade Feedback.resolvedBy makes.
  resolvedBy   User?   @relation("AttendanceResolver", fields: [resolvedById], references: [id])
  resolvedById String?

  /// Why a CORRECTED end is what it is, or why a session was written off.
  /// Plain text, never rendered as markup — the same contract as Comment.body.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One open session per person, enforced by Postgres rather than by a
  /// read-then-write in the service, which two taps on a slow connection will
  /// lose: under READ COMMITTED the second transaction's SELECT cannot see the
  /// first's uncommitted INSERT.
  ///
  /// `@@unique([memberId, resolution])` would NOT do this job — Postgres treats
  /// NULLs as distinct, so every open row would be permitted. Do not
  /// "simplify" it into one.
  ///
  /// Note Prisma still exposes `memberId` alone in the WhereUniqueInput, so
  /// `findUnique({ where: { memberId } })` type-checks while being unique only
  /// among open rows. Never use it as a selector; read the open session with
  /// `findFirst({ where: { memberId, resolution: null } })`. This index's real
  /// job is failing the second concurrent punch-in with P2002.
  @@unique([memberId], where: { resolution: null })
  /// One member's sessions in a window: the topbar's day total, a week figure,
  /// a future export. Range column last, matching ActivityLog's [clientId, at].
  @@index([memberId, startedAt])
}

/// What a piece of feedback is about. Kept deliberately short — a taxonomy
/// nobody can choose between is one everybody picks the first option from.
enum FeedbackKind {
  SUGGESTION
  PROBLEM
  PRAISE
}

/// Triage state. This exists so the feedback box is not a graveyard: without
/// it the page is a table nobody has any obligation to read, and the team
/// learns within a fortnight that submitting is pointless.
///
/// DECLINED is not a rejection of the person — it is the honest option that
/// keeps NEW meaningful. Without it an admin who disagrees with a suggestion
/// has only "leave it NEW forever", and the queue stops distinguishing
/// unread from unwanted.
enum FeedbackStatus {
  NEW
  ACKNOWLEDGED
  PLANNED
  DONE
  DECLINED
}

/// Somewhere for the team to say how the CMS is working for them.
///
/// The mirror image of Announcement, which is the same shape pointed the
/// other way — admin to team rather than team to admin. It is a separate
/// model rather than a flag on that one: an announcement is broadcast and
/// has no lifecycle, feedback is a queue and is nothing without one, and the
/// two have opposite read permissions. Nothing but the word "post" is shared.
model Feedback {
  id String @id @default(cuid())

  author   User   @relation("FeedbackAuthor", fields: [authorId], references: [id])
  authorId String

  kind   FeedbackKind   @default(SUGGESTION)
  body   String
  status FeedbackStatus @default(NEW)

  /// Which account this came from, for the day the CMS is sold as a service
  /// rather than run for one studio. Nullable and unused today: every row
  /// written now belongs to the studio running it, and there is no Account
  /// model yet to point a foreign key at.
  ///
  /// Added on the owner's ruling of 2026-08-07, before it is needed, because
  /// the cost is opposite at the two ends. One nullable column now is free.
  /// Later it is a migration plus a backfill whose correct value is genuinely
  /// unknowable — nothing in the row says which tenant a 2026 submission came
  /// from once there is more than one.
  accountId String?

  /// Who last moved it out of NEW, and when. Null while it is still NEW.
  /// Recorded because "acknowledged" with nobody's name against it is how a
  /// queue quietly becomes everyone-assumed-someone-else's job.
  resolvedBy   User?     @relation("FeedbackResolver", fields: [resolvedById], references: [id])
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([accountId])
}

model CalendarEvent {
  id String @id @default(cuid())

  title       String
  description String?

  /// The instant it starts, stored UTC like every other DateTime here.
  /// Grouping and display resolve it in APP_TIMEZONE (src/lib/dates.ts) and
  /// never here. Storing wall-clock time instead was rejected: it needs a
  /// second column naming the zone that clock belongs to, and six people in
  /// one city do not have a second zone to name.
  startsAt DateTime

  /// The instant it ends, exclusive: the event covers [startsAt, endsAt),
  /// half-open like calendarRange. A timed event ends later on the same app
  /// day it started. An all-day event ends at the NEXT app midnight — that is
  /// the exclusive bound, not a second day. Nullable was rejected: the day
  /// timeline draws a box, a box has a height, and "no end" would mean
  /// inventing one at render time. Postgres cannot express any of this
  /// without a CHECK constraint this schema has no precedent for, so the form
  /// shape and validateEventTimes own it — the same trade the polymorphic
  /// parents make at ActivityLog and Attachment.
  endsAt DateTime

  /// True for "Priya on leave" and anything else that owns a day rather than
  /// a slot. It is a real column, not startsAt-is-midnight: an event that
  /// genuinely starts at 00:00 exists, and inferring the flag from the clock
  /// would make it undrawable.
  allDay Boolean @default(false)

  /// Who arranged it. Never cascades — the same rule as Task.creator: a
  /// deactivated member's meetings are still on the calendar, and members are
  /// deactivated rather than deleted precisely so history keeps its people.
  creator   User   @relation("CalendarEventCreator", fields: [creatorId], references: [id])
  creatorId String

  /// Optional, and independent of each other. A project pins the client too
  /// (the service copies it, and disagreement is impossible because the form
  /// derives it); a client with no project is the sales pitch to a prospect,
  /// which has nowhere else to hang. Deriving clientId through projectId
  /// alone — the way Task does — was rejected for exactly that case.
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
  client    Client?  @relation(fields: [clientId], references: [id])
  clientId  String?

  attendees CalendarEventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The calendar's only query is a half-open window on startsAt, so the
  /// window column is the one that earns an index. projectId and clientId get
  /// theirs by the same house rule every other FK follows.
  @@index([startsAt])
  @@index([projectId])
  @@index([clientId])
}

/// One row per person per event, the shape TaskAssignee already proved. Not a
/// String[] on CalendarEvent: an array cannot be indexed by user, and "what is
/// on my plate this week" is the query this table exists for.
model CalendarEventAttendee {
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User          @relation(fields: [userId], references: [id])
  userId  String

  @@id([eventId, userId])
  @@index([userId])
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_MENTION
  TASK_STATUS_CHANGED
  ANNOUNCEMENT_POSTED

  /// Written by the reminder cron, which needs a deployed URL. The type
  /// exists now so the union is complete and describeNotification stays
  /// total; nothing writes it yet.
  TASK_DUE_SOON

  /// Attendees only, on create and when the time moves — never on a title or
  /// description edit, and never to the actor (notification-service.ts:45
  /// enforces that centrally). One type rather than two: describeNotification
  /// already branches on meta, so meta.movedFrom carries "scheduled" versus
  /// "moved" without widening this enum. meta carries { name, when, date }
  /// and optionally movedFrom; `date` is the YYYY-MM-DD app-zone day the link
  /// needs, and without it notificationHref has nowhere to point.
  EVENT_SCHEDULED
}

/// One row per person per event. Deliberately not shared: two people mentioned
/// in the same comment get a row each, because read state is personal and a
/// shared row could not carry it.
model Notification {
  id String @id @default(cuid())

  /// The person being told. Cascades: when a member is deleted their unread
  /// pile is meaningless, unlike the audit trail, which must survive.
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  /// The person who caused it, when a person did. Never equal to recipientId
  /// — nobody is told about their own action, and the services enforce it.
  ///
  /// Nullable because TASK_DUE_SOON has no actor: a deadline arriving is not
  /// something anybody did. The alternative — inventing a system user, or
  /// naming the recipient as their own actor — would make every reader of
  /// this column check for a sentinel instead of a null.
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id])
  actorId String?

  type NotificationType

  /// Where clicking it goes. Plain strings with no relation, the same
  /// decision as ActivityLog.entityType/entityId: the target may be deleted,
  /// and a foreign key would either block that delete or silently take the
  /// notification with it. `removeTask` clears them explicitly instead.
  entityType String
  entityId   String

  /// Display data captured at write time — the task title, the comment
  /// excerpt. Read rather than re-queried, so the panel is one query and a
  /// since-renamed task still reads as it did when the thing happened.
  meta Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// The panel's query is "mine, newest first"; the badge's is "mine, unread".
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

enum AttachmentParent {
  TASK
  PROJECT
  CLIENT
}

/// A file in R2. The row is the index; the bytes never touch this server.
model Attachment {
  id         String           @id @default(cuid())
  parentType AttachmentParent

  /// Deliberately NO relation and no onDelete — the same decision, for the
  /// same reason, as ActivityLog.clientId: a polymorphic parent cannot carry
  /// three foreign keys at once. The cost is real and is paid in the service
  /// layer — deleting a task, project or client must delete its R2 objects,
  /// because the database cannot cascade into a bucket. Do not "fix" this by
  /// adding a relation.
  parentId String

  /// The R2 object key. Unique, so a retried confirm cannot register twice.
  fileKey     String @unique
  fileName    String
  contentType String
  size        Int

  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  uploadedById String

  createdAt DateTime @default(now())

  @@index([parentType, parentId, createdAt])
}
